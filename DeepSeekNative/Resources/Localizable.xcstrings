    },
    "The main window also opens from the Dock or the menu bar icon. With auto-hide on, float the window on top before dragging files in from Finder, or paste them or use the upload button instead.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "也可以通过程序坞或菜单栏图标打开主窗口。开启“自动隐藏”后，从访达拖拽文件前需要先将窗口置顶，也可以改用粘贴或上传按钮。"
          }
        }
      }
    },
    "The page's web process quit several times in a short time. Try reloading, or clear the cache in Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网页进程在短时间内多次退出。可以尝试重新加载，或在设置中清除缓存。"
          }
        }
      }
    },
    "The server can't be reached. Check your network or proxy settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器暂时无法访问，请检查网络或代理设置。"
          }
        }
      }
    },
    "This deletes the account's cookies, local storage and cache on this Mac. Your chats stay in the cloud and come back when you sign in again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将删除该账户在本机保存的 Cookie、本地存储与缓存。云端聊天记录不受影响，重新登录后即可看到。"
          }
        }
      }
    },
