    "%lld%%": {
      "shouldTranslate": false
    },
    "A native macOS client for DeepSeek's official web app.\nRendered by the system's WebKit. No API key, no private APIs, no data collection.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基于 DeepSeek 官方网页版的原生 macOS 客户端。\n使用系统 WebKit 渲染，无需 API Key，不调用任何私有接口，不收集数据。"
          }
        }
      }
    },
    "A native macOS client for DeepSeek's official web app.\nUses the system's WebKit. No API key needed, and no data collected.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "基于 DeepSeek 官方网页版的原生 macOS 客户端。\n使用系统 WebKit，无需 API Key，不收集任何数据。"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
