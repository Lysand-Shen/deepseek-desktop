        }
      }
    },
    "Its sign-in and website data on this Mac will be permanently deleted.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该账户在本机的登录状态与网站数据将被永久删除。"
          }
        }
      }
    },
    "Keep running in the background after closing the window": {
