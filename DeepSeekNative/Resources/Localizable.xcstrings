    "Allow DeepSeek in System Settings › General › Login Items.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要在“系统设置 › 通用 › 登录项”中允许 DeepSeek。"
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外观"
          }
        }
      }
    },
    "Ask DeepSeek…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向 DeepSeek 提问…"
          }
        }
      }
    },
    "Ask where to save each download": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次下载前询问保存位置"
          }
        }
      }
    },
    "At least one stays on, so you can always get back to the window. Click the menu bar icon to show or hide the window, or right-click it for a menu.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两者至少保留一个，方便随时找回窗口。点按菜单栏图标可显示或隐藏窗口，右键点按打开菜单。"
          }
        }
      }
    },
    "Back": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后退"
          }
        }
      }
    },
    "Back / Forward": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后退 / 前进"
          }
        }
      }
    },
    "Bring All to Front": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "前置全部窗口"
          }
