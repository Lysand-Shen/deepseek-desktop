    "Include at least one of ⌘, ⌥ or ⌃": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请至少包含 ⌘、⌥ 或 ⌃ 中的一个修饰键"
