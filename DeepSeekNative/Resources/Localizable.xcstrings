    "Check your network connection. The page reloads automatically when you're back online.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查网络连接。网络恢复后会自动重新加载。"
          }
        }
      }
    },
