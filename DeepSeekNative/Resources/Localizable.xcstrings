    "Download": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载文件"
          }
        }
      }
    },
    "Downloaded “%@”": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已下载“%@”"
          }
        }
      }
    },
    "Downloads": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "下载"
          }
        }
      }
    },
    "Each account has its own cookies and local storage, so several DeepSeek accounts can stay signed in and you can switch between them at any time.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个账户拥有独立的 Cookie 与本地存储，可同时保持多个 DeepSeek 账号的登录状态并随时切换。"
          }
        }
      }
    },
