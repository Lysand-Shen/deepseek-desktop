    "Menus, Settings and dialogs switch right away. Menu items provided by macOS, and the default language of DeepSeek's web page, switch after a restart.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单、设置和对话框会立即切换。由 macOS 提供的菜单项，以及 DeepSeek 网页的默认语言，会在重新启动后切换。"
          }
        }
      }
    },
