<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	The app is distributed outside the Mac App Store and signed ad hoc, so App Sandbox is
	off: with an ad hoc signature every rebuild would trip container-ownership prompts.
	Hardened Runtime stays on, and web content runs in WebKit's own sandboxed processes.
	-->
</dict>
</plist>
